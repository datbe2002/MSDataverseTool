{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hexa Studio",
  "version": "0.2.0",
  "identifier": "com.hexastudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hexa Studio",
        "label": "main",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxM0E4NkYyODlEQUY1OApSV1JZcjUwb2I2Z1RCSkRrZ2hTQmo2Q3NseFZzV0cvNEo4dnhUbWkwd1dkY3VNb0lLVnRLSTVrego=",
      "endpoints": ["https://github.com/datbe2002/MSDataverseTool/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
